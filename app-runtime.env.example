# Template for the APP_RUNTIME_ENV secret of the DEISI deployment
# (docs/development/deisi-deployment.md). Fill in the two placeholders,
# keep values without quotes, store it with gh secret set and delete the copy.
DATABASE_URL=postgresql://<role>:<password>@<endpoint>.eu-central-1.aws.neon.tech/<database>?sslmode=require&channel_binding=require
SECRET_KEY=<64 hex characters from python -c "import secrets; print(secrets.token_hex(32))">
CORS_ORIGINS=["https://lace.apps.deisi.ulusofona.pt"]
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
SESSION_EXPIRE_MINUTES=60
PASSWORD_MIN_LENGTH=10
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_LETTER=true
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
MAX_UPLOAD_MB=10
MAX_IMPORT_ROWS=50000
